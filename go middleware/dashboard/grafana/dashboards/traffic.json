{
  "title": "Gateway Traffic",
  "uid": "gateway-traffic",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Requests/sec by decision",
      "gridPos": { "x": 0, "y": 0, "w": 16, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [{ "refId": "A", "legendFormat": "{{decision}}",
        "expr": "sum by (decision)(rate(gateway_requests_total[30s]))" }]
    },
    {
      "id": 2, "type": "stat", "title": "Allowed (last 5m)",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [{ "refId": "A",
        "expr": "sum(increase(gateway_requests_total{decision=\"allowed\"}[5m]))" }]
    },
    {
      "id": 3, "type": "stat", "title": "Blocked (last 5m)",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [{ "refId": "A",
        "expr": "sum(increase(gateway_requests_total{decision=~\"rate_limited|blocked\"}[5m]))" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "p95 latency",
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "legendFormat": "p95",
        "expr": "histogram_quantile(0.95, sum by (le)(rate(gateway_request_duration_seconds_bucket[1m])))" }]
    }
  ]
}
